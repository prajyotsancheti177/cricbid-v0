SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Recipient for the daily activity summary email (defaults to prajyotsancheti177@gmail.com)
DAILY_SUMMARY_EMAIL=prajyotsancheti177@gmail.com
