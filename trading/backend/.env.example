# Copy to .env and fill in. Everything works WITHOUT Kite credentials
# (simulated market data + paper trading); add them for real data / live orders.

# From https://developers.kite.trade (create a Kite Connect app)
TRADING_KITE_API_KEY=
TRADING_KITE_API_SECRET=

# LIVE trading master switch. Keep false until your strategy has a paper track record.
TRADING_LIVE_TRADING_ENABLED=false

# Global live safety rails
TRADING_LIVE_MAX_ORDERS_PER_DAY=50
TRADING_LIVE_MAX_ORDER_VALUE=100000
TRADING_LIVE_MAX_DAILY_LOSS=10000

# Paper trading
TRADING_PAPER_STARTING_CASH=1000000
TRADING_PAPER_SLIPPAGE_PCT=0.02
